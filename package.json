{
  "name": "rex-pierre-diffs",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "rex-pierre-diffs": "./dist-node/cli.js",
    "rpd": "./dist-node/cli.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -p tsconfig.node.json && node -e \"require('node:fs').chmodSync('dist-node/cli.js', 0o755)\" && vite build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "start": "node dist-node/server.js",
    "test": "tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@pierre/diffs": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "A graphical Git diff reviewer for Rex Terminal, powered by Pierre Diffs.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist-node",
    "dist",
    "README.md",
    "rex-pierre-diffs.lua",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akadotsh/rex-pierre-diffs.git"
  },
  "homepage": "https://github.com/akadotsh/rex-pierre-diffs#readme",
  "bugs": {
    "url": "https://github.com/akadotsh/rex-pierre-diffs/issues"
  }
}
