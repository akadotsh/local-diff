{
  "name": "local-diff",
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "local-diff": "./dist-node/cli.js"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.node.json && npm run build:pixel && node scripts/run-local.mjs --dev",
    "build": "tsc -p tsconfig.node.json && node -e \"require('node:fs').chmodSync('dist-node/cli.js', 0o755)\" && npm run build:pixel && vite build",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "test:standalone": "npm run build:standalone && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "start": "node dist-node/server.js",
    "test": "tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js && node --test hosts/pixel/tests/*.test.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p hosts/pixel/tsconfig.json --noEmit",
    "local": "npm run build -- --logLevel warn && node scripts/run-local.mjs",
    "test:local": "npm run check && npm run build && npm test",
    "build:pixel": "tsc -p hosts/pixel/tsconfig.json",
    "test:explorer:rexweb": "npm run build && node scripts/test-explorer-ui.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.2",
    "chokidar": "^4.0.3",
    "dompurify": "^3.5.0",
    "marked": "^18.2.1",
    "@zenbu-labs/pixel": "0.3.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.0.0",
    "@pierre/trees": "^1.0.0",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.25.12",
    "material-icon-theme": "^5.40.0",
    "react-dom": "18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "description": "A graphical Git diff reviewer for Rex Terminal, powered by Pierre Diffs.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist-node",
    "dist",
    "README.md",
    "local-diff.lua",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "hosts/pixel/dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akadotsh/local-diff.git"
  },
  "homepage": "https://github.com/akadotsh/local-diff#readme",
  "bugs": {
    "url": "https://github.com/akadotsh/local-diff/issues"
  },
  "allowScripts": {
    "@zenbu-labs/pixel": true,
    "esbuild": true
  }
}
